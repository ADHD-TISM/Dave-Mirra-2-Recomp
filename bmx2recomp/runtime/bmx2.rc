// Windows resources for bmx2.exe: the manifest, the icon and the name shown in
// Explorer and Task Manager. bmx2.ico is made at build time from the player's
// own disc (tools/make_icon.py) and lives in the generated folder, never in the
// repo; the build passes -D BMX2_ICON when it exists.
#ifdef BMX2_ICON
1 ICON "bmx2.ico"
#endif

// UTF-8 paths (see bmx2.manifest). 1 = the process manifest, 24 = RT_MANIFEST.
1 24 "bmx2.manifest"

// No version numbers: nothing ties them to the release tag, so they would drift.
1 VERSIONINFO
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Dave Mirra Freestyle BMX 2"
      VALUE "ProductName", "Dave Mirra Freestyle BMX 2"
      VALUE "InternalName", "bmx2"
      VALUE "OriginalFilename", "bmx2.exe"
      VALUE "Comments", "PC recompilation, early work in progress"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
